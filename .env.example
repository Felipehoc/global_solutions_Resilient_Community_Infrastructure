# Exemplo de Variáveis de Ambiente - Rede Comunitária Vila Aurora (GS 2026.2)
# Copie para .env antes de iniciar o ambiente. NUNCA versione segredos reais!

ENV_MODE=lab_simulation
NTP_SERVER=a.st1.ntp.br
TIMEZONE=America/Sao_Paulo

# Configuração do Broker MQTT Local (Borda)
MQTT_HOST=mosquitto-edge
MQTT_PORT_TLS=8883
MQTT_CA_CERT=certs/ca.crt
MQTT_CRL_FILE=certs/crl.pem

# Configuração da VPN WireGuard (Borda <-> Nuvem)
WG_INTERFACE=wg0
WG_CLOUD_ENDPOINT=10.200.0.1:51820
WG_EDGE_IP=10.200.0.2/24

# Configuração do Banco de Dados (Menor Privilégio - RT-08)
DB_ENGINE=sqlite
DB_PATH=data/vila_aurora_core.db
DB_APP_USER=app_vila_aurora_least_priv
DB_PASSWORD_PLACEHOLDER=CHANGE_ME_IN_LOCAL_ENV_ONLY

# Segredo de Pseudonimização LGPD (Salt Sintético de Laboratório - RT-19)
LGPD_PSEUDONYM_SALT=vila_aurora_synthetic_salt_2026_lab

# Segredo de Demonstração TOTP MFA (Apenas Contas Sintéticas de Laboratório - RT-09)
LAB_TOTP_BASE32_OPERADOR=JBSWY3DPEHPK3PXP
LAB_TOTP_BASE32_TECNICO=JBSWY3DPEHPK3PXQ
LAB_TOTP_BASE32_COORDENACAO=JBSWY3DPEHPK3PXR
LAB_TOTP_BASE32_AUDITOR=JBSWY3DPEHPK3PXS
